{
  "name": "hugo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/main.css --no-source-map",
    "dev": "npm run build:css && hugo server",
    "build": "npm run build:css && hugo",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:md": "markdownlint-cli2 \"README.md\"",
    "lint:css": "stylelint \"assets/**/*.scss\" --allow-empty-input",
    "lint": "npm run lint:md && npm.cmd run lint:css",
    "validate": "npm run format:check && npm run lint && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint-cli2",
      "prettier --write"
    ],
    "*.{json,jsonc,toml,yml,yaml,css,scss,js,cjs,mjs}": [
      "prettier --write"
    ],
    "assets/**/*.scss": [
      "stylelint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
